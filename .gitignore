# Dependencies
node_modules/

# Build output
dist/
build/
.vite/
*.tsbuildinfo

# Environment and secrets — never committed, see docs/threat-model.md
.env
.env.*
!.env.example
*.pem
# The CI user's public key is public and must be committed: Terraform reads it
# on every apply (infra/ci.tf). Its private half lives only in GitHub.
!infra/ci.pub.pem
*.key
*.keystore

# Terraform — state may contain sensitive values
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# .terraform.lock.hcl is deliberately NOT ignored. It pins provider versions
# and their checksums, which is the only thing making `terraform init`
# reproducible across machines and over time.

# Local tooling
.DS_Store
*.log
.idea/
.vscode/
coverage/
dist-coverage/
dist-bundle/
