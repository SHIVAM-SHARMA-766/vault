{
  "name": "@vault/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The vault client. Everything secret is derived, decrypted, and held here.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run check:csp",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "check:csp": "node scripts/check-csp.mjs"
  },
  "dependencies": {
    "@vault/crypto": "*",
    "react": "^19.3.1",
    "react-dom": "^18.3.1",
    "@vault/site": "*",
    "@vault/core": "*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.0"
  }
}
