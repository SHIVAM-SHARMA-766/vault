# How the client and the API are served.
#
# This lives with the application, not in cloud-init, because it describes how
# the app is served rather than how the machine is built — and because a change
# here should not replace the host. scripts/deploy.sh installs it.
#
# cloud-init writes a minimal version of this at first boot so that Caddy can
# obtain a certificate before anything has been deployed. This one replaces it.

{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		# No unsafe-inline and no unsafe-eval anywhere. 'wasm-unsafe-eval' lets
		# Argon2id compile its WebAssembly (decisions/0028); it allows no JavaScript eval.
		# Otherwise: The build must emit
		# external scripts and stylesheets only; apps/web/scripts/check-csp.mjs
		# asserts that it does, because the failure here is a blank page rather
		# than an error.
		#
		# img-src omits remote hosts deliberately. Fetching site favicons from
		# a third party would tell that third party which services the vault
		# holds accounts for, which is most of what the encryption protects.
		# Website icons come from this server instead (/api/icons/<host>, no
		# sign-in sent), and can be turned off in Preferences.
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}
}

{$VAULT_HOSTNAME} {
	encode zstd gzip

	# Three things share this origin: the API, the vault client under /app/,
	# and the public site at /. Sharing it is what lets the policy say
	# connect-src 'self'. The site ships no JavaScript, and its editable text is
	# escaped by the renderer, so living beside the client gives nothing that
	# runs there a way into it.
	#
	# The site is rendered by the API from the content published in the admin
	# panel, into /srv/vault/site/<version>, with /srv/vault/site/current
	# pointing at the live one. Images uploaded there live in /srv/vault/site/media.

	# The API.
	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	# The vault client.
	redir /app /app/ 308
	handle /app/* {
		root * /srv/vault/web

		# Fall back to the shell only for paths that look like client-side
		# routes: no file on disk, and no file extension. A request for a
		# missing asset must stay a 404 — returning HTML with status 200
		# instead turns a mistyped script URL into a confusing parse error in
		# the browser rather than an obvious missing file.
		@spa {
			not file
			not path_regexp \.[a-zA-Z0-9]+$
		}
		rewrite @spa /app/index.html

		file_server
	}

	# Images uploaded from the admin panel. Only the three raster types the
	# API accepts are served; anything else here is a 404.
	@media path_regexp ^/media/m_[A-Za-z0-9_-]+\.(png|jpg|webp)$
	handle @media {
		root * /srv/vault/site
		file_server
	}
	handle /media/* {
		respond 404
	}

	# The public site: plain files, with /security answering for
	# security.html.
	handle {
		root * /srv/vault/site/current
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# Anything missing gets the site's 404 page, with the 404 status kept.
	handle_errors 404 {
		root * /srv/vault/site/current
		rewrite * /404.html
		file_server
		import security_headers
	}

	import security_headers

	# Caching, as two matchers that cannot both match.
	#
	# Writing this as a default plus an override did not work: both header
	# directives applied and the order between them is not something to rely
	# on, so the hashed assets ended up marked no-store as well. And a rule on
	# /index.html never fires for a request to /, which is how the shell ended
	# up with no cache header at all.
	#
	# A cached shell is the failure that matters: after a deploy it points at
	# hashed assets that no longer exist, and the page is blank with nothing in
	# the console to explain it.
	@assets path /app/assets/*
	@not-assets not path /app/assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header @not-assets Cache-Control "no-store"
}

# The reference instance's previous address (2026-11-06 to 2026-11-26). Kept
# for a while so old bookmarks, emailed links and share links still arrive:
# every request moves to the same path on the current address. Remove once
# the DuckDNS record is retired.
vault-shivam.duckdns.org {
	redir https://{$VAULT_HOSTNAME}{uri} permanent
}
