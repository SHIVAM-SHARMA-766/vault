# The identity GitHub Actions publishes releases as.
#
# It can write objects to the releases bucket and do nothing else in the
# tenancy: no other bucket, no instance, no database, no IAM. That is the whole
# of what the release pipeline needs, and anything more would turn a leaked CI
# secret into more than the ability to publish a release.
#
# Publishing a release is still powerful — the host installs whatever
# `current` names, and that code reaches the browser (threat model A3) — so
# this user is the second most sensitive credential the project has, after the
# hostname. See decisions/0008-release-pipeline.md.
#
# The API key is created from a public key generated by scripts/setup-ci.sh,
# which writes it to infra/ci.pub.pem (public, committed). The private half goes
# straight into a GitHub Actions secret and is never written to this repository
# or to Terraform state. With no ci.pub.pem, no CI user exists.

locals {
  ci_public_key = fileexists("${path.module}/ci.pub.pem") ? trimspace(file("${path.module}/ci.pub.pem")) : ""
  ci_enabled    = local.ci_public_key != ""
}

resource "oci_identity_user" "ci" {
  count          = local.ci_enabled ? 1 : 0
  compartment_id = var.tenancy_ocid
  name           = "${local.name}-ci"
  description    = "GitHub Actions: publishes releases to the releases bucket, nothing else."
  freeform_tags  = var.default_tags
}

resource "oci_identity_group" "ci" {
  count          = local.ci_enabled ? 1 : 0
  compartment_id = var.tenancy_ocid
  name           = "${local.name}-ci"
  description    = "Release publishers for the vault."
  freeform_tags  = var.default_tags
}

resource "oci_identity_user_group_membership" "ci" {
  count    = local.ci_enabled ? 1 : 0
  user_id  = oci_identity_user.ci[0].id
  group_id = oci_identity_group.ci[0].id
}

resource "oci_identity_policy" "ci" {
  count          = local.ci_enabled ? 1 : 0
  compartment_id = var.tenancy_ocid
  name           = "${local.name}-ci"
  description    = "Release publishers may write to the releases bucket and nowhere else."
  statements = [
    "Allow group ${oci_identity_group.ci[0].name} to manage objects in tenancy where target.bucket.name = '${oci_objectstorage_bucket.releases.name}'",
    "Allow group ${oci_identity_group.ci[0].name} to read buckets in tenancy where target.bucket.name = '${oci_objectstorage_bucket.releases.name}'",
  ]
  freeform_tags = var.default_tags
}

resource "oci_identity_api_key" "ci" {
  count     = local.ci_enabled ? 1 : 0
  user_id   = oci_identity_user.ci[0].id
  key_value = local.ci_public_key
}

output "ci_user_ocid" {
  description = "The CI user, for the OCI_USER_OCID GitHub secret."
  value       = local.ci_enabled ? oci_identity_user.ci[0].id : null
}

output "ci_key_fingerprint" {
  description = "Fingerprint of the CI user's API key, for the OCI_FINGERPRINT GitHub secret."
  value       = local.ci_enabled ? oci_identity_api_key.ci[0].fingerprint : null
}
