{
  "name": "@vault/api",
  "version": "0.0.0",
  "private": true,
  "description": "The vault API. One Node process behind Caddy on a single host.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/",
    "bundle": "node scripts/bundle.mjs",
    "openapi": "npm run build && node scripts/openapi.mjs"
  },
  "dependencies": {
    "@vault/crypto": "*",
    "@vault/site": "*",
    "better-sqlite3": "^11.7.0",
    "mysql2": "^3.11.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  },
  "main": "./dist/src/main.js"
}
