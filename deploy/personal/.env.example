# The address people will use. It must resolve to this machine, and ports 80
# and 443 must reach it, for Caddy to obtain a certificate. "localhost" works
# for trying it out (Caddy's local CA; the browser will warn once).
VAULT_HOSTNAME=vault.example.com

# Only if 80/443 are taken on this machine.
# HTTP_PORT=80
# HTTPS_PORT=443
# ...and then the full address, so links Vault prints are right:
# SITE_ORIGIN=https://vault.example.com:8443

# Backups: set a passphrase (16+ characters) and keep a copy of it away from
# this machine. Daily encrypted backups then go to the vault-data volume
# (/data/backups); add S3 for an off-site copy. A backup file plus this
# passphrase is a complete restore. See docs/INSTALL.md.
BACKUP_PASSPHRASE=
# BACKUP_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=eu-central-1
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
