{
  "name": "@vault/core",
  "version": "0.0.0",
  "private": true,
  "description": "Code every Vault client shares and no UI owns: QR encoding today; the item model, search and import/export next. No third-party dependencies.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./words": {
      "types": "./dist/src/words.d.ts",
      "default": "./dist/src/words.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
