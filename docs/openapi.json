{
  "openapi": "3.1.0",
  "info": {
    "title": "Vault API",
    "version": "1",
    "description": "Zero-knowledge password manager API. Every entry, folder and history body is ciphertext sealed in the client; the server stores and returns it without being able to read it. Routes marked x-permission also need that staff permission."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "apiKey",
        "in": "header",
        "name": "x-vault-auth",
        "description": "Bearer <access token>. A custom header, so a cross-site request cannot send it."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "bad_request",
              "invalid_content",
              "unauthorized",
              "invalid_credentials",
              "two_factor_required",
              "invalid_two_factor",
              "forbidden",
              "not_found",
              "conflict",
              "too_large",
              "rate_limited",
              "unavailable",
              "internal"
            ],
            "description": "bad_request: The request is malformed or a field is invalid; `details` may say which.\ninvalid_content: Website content failed validation; `details` lists each field.\nunauthorized: No valid access token.\ninvalid_credentials: Sign-in failed. Deliberately does not say why.\ntwo_factor_required: The password was right; a TOTP or recovery code is needed too.\ninvalid_two_factor: The TOTP or recovery code is wrong or already used.\nforbidden: Signed in, but not permitted (role, disabled account, closed registration).\nnot_found: No such route or item.\nconflict: The item already exists, or the change conflicts with the current state.\ntoo_large: The body or a stored item exceeds its size limit.\nrate_limited: Too many requests; wait `retry-after` seconds.\nunavailable: The feature is not configured on this server.\ninternal: An unexpected error. Quote `requestId` when reporting it."
          },
          "message": {
            "type": "string",
            "description": "For people. Clients branch on `error`, not on this."
          },
          "details": {
            "description": "Field-level problems, when there are any."
          },
          "requestId": {
            "type": "string",
            "description": "Also in the x-request-id header; matches the server log."
          }
        }
      }
    }
  },
